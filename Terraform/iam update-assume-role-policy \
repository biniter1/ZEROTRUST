{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "GitHubOIDCEKSDeploy",
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::492462084314:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
                },
                "StringLike": {
                    "token.actions.githubusercontent.com:sub": "repo:biniter1/ZEROTRUST:ref:refs/heads/main"
                }
            }
        }
    ]
}
